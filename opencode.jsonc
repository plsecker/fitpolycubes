{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "openrouter": {
      "models": {
        "openai/gpt-5.5": {
          "options": {
            "max_tokens": 16000
          }
        },
        "~google/gemini-flash-latest": {
          "options": {
            "max_tokens": 16000
          }
        }
      }
    }
  },

  "agent": {
    "polycubecoder": {
      "model": "openrouter/openai/gpt-5.5"
    },
    "polycubearchitect": {
      "model": "openrouter/~google/gemini-flash-latest"
    }
  }
}
