 // Record degree changes for rollback. Each entry is (col, delta).
 using DegChange = std::pair<int,int>;
 
+// Reusable per-thread scratch for coalescing all degree decrements in one
+// selected-row removal transaction. Epoch marks avoid clearing O(num_cols)
+// scratch on every branch. Only columns that remain active are recorded.
+struct DegreeDeltaScratch {
+    std::vector<uint32_t> seen_epoch;
+    std::vector<int> pending_delta;
+    std::vector<int> touched_cols;
+    uint32_t epoch = 0;
+
+    void init(int num_cols) {
+        if (seen_epoch.size() != static_cast<size_t>(num_cols)) {
+            seen_epoch.assign(static_cast<size_t>(num_cols), 0);
+            pending_delta.assign(static_cast<size_t>(num_cols), 0);
+            epoch = 0;
+        }
+        touched_cols.clear();
+        touched_cols.reserve(static_cast<size_t>(num_cols));
+    }
+
+    void begin_transaction() {
+        touched_cols.clear();
+        if (++epoch == 0) {
+            std::fill(seen_epoch.begin(), seen_epoch.end(), 0);
+            epoch = 1;
+        }
+    }
+
+    void add_decrement(int col) {
+        const size_t i = static_cast<size_t>(col);
+        if (seen_epoch[i] != epoch) {
+            seen_epoch[i] = epoch;
+            pending_delta[i] = 0;
+            touched_cols.push_back(col);
+        }
+        ++pending_delta[i];
+    }
+};
+static thread_local DegreeDeltaScratch g_degree_delta_scratch;
