+// Accumulate the degree effects of all rows killed by one selected placement,
+// then update each still-active column and its degree-1 membership once.
+// No search, propagation, or forced-column query occurs until this transaction
+// has committed, so only the final degrees and one_deg_set state are observable.
+static void apply_row_removals_coalesced(
+    const CSR& Y,
+    const std::vector<uint8_t>& active_cols,
+    const std::vector<int>& removed_rows,
+    std::vector<DegChange>& changes) {
+    g_degree_delta_scratch.begin_transaction();
+    for (const int row : removed_rows) {
+        for (int k = Y.indptr[row]; k < Y.indptr[row + 1]; ++k) {
+            const int col = Y.data[k];
+            if (active_cols[col]) {
+                g_degree_delta_scratch.add_decrement(col);
+            }
+        }
+    }
+
+    for (const int col : g_degree_delta_scratch.touched_cols) {
+        const int decrement =
+            g_degree_delta_scratch.pending_delta[static_cast<size_t>(col)];
+        const int old_deg = g_deg[col];
+        const int new_deg = old_deg - decrement;
+        // Preserve the trail's existing (column, negative-delta) convention;
+        // rollback_deg_changes adds the coalesced amount back in one step.
+        changes.emplace_back(col, -decrement);
+        g_deg[col] = new_deg;
+        mrv_update_one_deg(col, old_deg, new_deg, true);
+    }
+    g_degree_delta_scratch.touched_cols.clear();
+}
